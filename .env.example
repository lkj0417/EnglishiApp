# Database
DATABASE_URL=postgresql://englishi:englishi_dev_password@localhost:5432/englishi_db

# Redis
REDIS_URL=redis://localhost:6379

# OpenAI（可选，数据库配置提供商后可不填）
OPENAI_API_KEY=sk-your-openai-key-here

# Azure Cognitive Speech
AZURE_SPEECH_KEY=your-azure-speech-key-here
AZURE_SPEECH_REGION=eastasia

# JWT
JWT_SECRET=your-very-long-random-jwt-secret-here

# 管理员账户（首次启动时 seed 脚本使用）
ADMIN_EMAIL=admin@englishi.app
ADMIN_PASSWORD=Admin@123456
ADMIN_SECRET=your-admin-secret-for-registration

# API Key 加密密钥（32字符，用于加密存储在数据库中的 API Key）
ENCRYPTION_KEY=your-32-character-encryption-key!!

# App
NODE_ENV=development
API_PORT=3001
AI_SERVICE_PORT=3002
ADMIN_PORT=3003

# 管理员后台（前端配置）
NEXT_PUBLIC_API_URL=http://localhost:3001/v1

